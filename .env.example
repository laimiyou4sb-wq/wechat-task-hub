# ===== 服务 =====
HOST=0.0.0.0
PORT=8765
# 手机访问令牌：源码运行时请改成自己的随机串；打包版首次启动会自动生成随机串
APP_TOKEN=change-me-please
# 对外基础地址（可选）：留空 = 自动探测局域网 IP。
# 远程访问已改用 ngrok 隧道（tools/tunnel.py 把公网地址写进 data/tunnel.json，服务端 pairing 读取），
# 这里只在「用反向代理 / CDN 固定对外地址」时才填完整地址（https://...，不要带末尾斜杠）。
APP_BASE_URL=

# 数据源：wcda = WeChatDataAnalysis（唯一数据源，走「采集」）；demo = 不连数据源
DATA_SOURCE=wcda

# ===== wcda 采集（唯一采集方法：localId 游标 + 按会话轮询）=====
# 桌面端运行后本地 API 默认端口 10392
WCDA_BASE=http://127.0.0.1:10392
# 多账号时指定账号目录名，留空 = 当前账号
WCDA_ACCOUNT=

# ===== 过滤 =====
# 只监控这些聊天（群名 / 联系人备注 / wxid，逗号分隔）；留空 = 不额外限制
GROUP_WHITELIST=
# 白名单模式：all=全部；pinned=仅置顶聊天；custom=仅自定义名单；pinned_custom=置顶+自定义
WHITELIST_MODE=all
# 置顶会话自动刷新间隔（秒）
PINNED_REFRESH_SECONDS=60
# 是否也处理私聊
INCLUDE_PRIVATE=0
# 我的昵称/备注（用于识别 @我），逗号分隔；外号、同音字/错别字写法也可以填在这里
ME_NAMES=

# ===== @/点名 身份判定 =====
# 我的 wxid；留空 = 自动从 WeChatDataAnalysis 识别（推荐）
ME_WXID=
# 是否丢弃「明确 @ 别人 / 点名指派别人」的消息（1=开启；关闭则完全恢复旧逻辑）
IDENTITY_FILTER=1
# 是否启用错别字/同音模糊匹配（1=开启；只在 @/直呼/指派等强上下文里生效）
IDENTITY_FUZZY=1
# 我的账号 / 各群群昵称 / 群成员的缓存时间（秒）
IDENTITY_TTL_SECONDS=600

# ===== wcda 采集参数（唯一采集方法：启动 8 秒先采一次，之后每轮按 localId 游标续采）=====
# 采集轮间隔（秒；0=关闭）
WCDA_CATCHUP_SECONDS=120
# 每轮最小回看窗口（分钟；无 localId 的行 / 游标失效时按时间窗兜底）
WCDA_CATCHUP_LOOKBACK_MINUTES=30
# 启动时额外回补窗口（分钟；0=只按会话游标采，不停机也不额外回看）
WCDA_BACKFILL_MINUTES=0
# 每个会话最多拉取条数（旧版单次路径；新版按 PAGE_SIZE 分页）
WCDA_CATCHUP_LIMIT=300
# 单会话单轮最长回看（小时），长时间离线后按 localId 游标分页补齐全部未采消息
WCDA_CATCHUP_MAX_HOURS=168
# 无游标且服务启动前没有该会话任何历史消息时，自动回看窗口（小时，默认 1 天）
WCDA_CATCHUP_EMPTY_HISTORY_HOURS=24
# 分页每页条数（50~1000）
WCDA_CATCHUP_PAGE_SIZE=500
# 单会话单轮最多拉取条数（防接口异常失控）
WCDA_CATCHUP_MAX_MESSAGES=50000
# 每轮最多处理条数（0=不限制），超出部分保留 processed=0，下一轮自动继续
WCDA_CATCHUP_ROUND_BUDGET=2000
# 时间水位重叠回看（秒）；仅在 localId 游标缺失/失效、退回时间窗时生效
WCDA_CATCHUP_OVERLAP_SECONDS=300
# 新置顶的聊天自动回补最近 N 分钟（0=不回补）
WCDA_NEW_PIN_BACKFILL_MINUTES=120
# 晚到消息兜底深扫：localId 游标之外，每 N 分钟按时间窗重扫一次（0=关闭）。
# WCDA 分页按 createTime 排序，PC 断网/休眠后补同步的「写入晚、业务时间旧」消息
# 可能落在游标扫描深度之外，深扫负责把它们捞回来（不推进游标、rawid 去重不重复建待办）。
WCDA_DEEP_SCAN_MINUTES=60
# 深扫回看窗口（分钟，默认 24 小时）：晚到消息的兜底上限就是本窗口（不是 WCDA_CATCHUP_MAX_HOURS）；
# 断网/休眠更久后补同步的晚到消息需调大该值，代价是每次深扫多翻页。
WCDA_DEEP_SCAN_LOOKBACK_MINUTES=1440
# 单条消息处理失败的最大重试次数：超限后进「失败队列」并推送告警，
# 不再自动重试，也不阻塞同一会话的后续消息（设置页可一键重试失败队列）。
# 整体性故障（如 LLM/网络中断）不消耗重试次数：大积压先隔离探测前 30 条，样本全失败只记 last_error，下轮重试。
MESSAGE_MAX_ATTEMPTS=3
# 注意：每轮拿到消息后按会话一次处理，不再按 80 条切批；
# 同一轮新建的待办会合并成一条推送，不会按会话连续推送多次。

# ===== 归纳总结 =====
# 手动待办「已忽略去重」：忽略后多少天内，同类消息不再重复新建待办（0=关闭）
# 只作用于「手机添加 / 手动添加」的待办；已完成（done）不参与；超过窗口或明显是新一期活动仍照常新建
MANUAL_SUPPRESS_DAYS=30
# 不按时间自动关闭事项：同一件事隔天再被聊到仍是归并目标
# 大模型（OpenAI 兼容）；不填 API Key 则使用本地规则提取
LLM_ENABLED=1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ===== 推送到手机 =====
# iOS：Bark App 里拿到的 https://api.day.app/xxxxx
PUSH_BARK_URL=
# Android / 任意：ntfy 主题（可自建服务器）
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# 免打扰时段（只影响推送，不影响入库）
PUSH_QUIET_START=23:00
PUSH_QUIET_END=07:30
# 每天定时推送一份待办摘要（HH:MM，留空关闭）
DAILY_DIGEST_TIME=08:30

# ===== 远程访问隧道（ngrok 固定域名）=====
# 1=启用远程访问：双击桌面「微信待办」时自动启动隧道（ngrok），公网地址写入 data/tunnel.json，
#   手机 App 在外网时自动使用它；0=只用局域网直连。
# 配置步骤：运行 tools\ngrok_setup.ps1（免费 ngrok 账号即可），脚本会自动把这里改成 1。
TUNNEL_ENABLED=0
# ngrok 免费账号的固定 dev domain，形如 xxx-yyy.ngrok-free.dev（新版）或 xxx-yyy.ngrok-free.app（旧版）
# 查看：https://dashboard.ngrok.com/domains
# 留空 = ngrok 自动使用账号分配的那个固定域名（同样固定，推荐留空，避免后缀猜错）
NGROK_DOMAIN=
# authtoken 由 tools\ngrok_setup.ps1 写进 %LOCALAPPDATA%\ngrok\ngrok.yml，一般不用在这里填
#（仅当想用环境变量覆盖配置文件时才填）
NGROK_AUTHTOKEN=
# 可选：ngrok.exe 路径（默认 tools\ngrok\ngrok.exe）、ngrok.yml 路径（默认 %LOCALAPPDATA%\ngrok\ngrok.yml）
# NGROK_BIN=
# NGROK_CONFIG=
# 心跳自愈：每 TUNNEL_HEALTH_INTERVAL 秒校验一次公网 /api/health，连续失败 TUNNEL_MAX_FAILURES 次自动重启隧道
TUNNEL_HEALTH_INTERVAL=60
TUNNEL_MAX_FAILURES=3
# 应急备用通道：cloudflared 快速隧道（免注册，但地址每次启动都变，仅临时用）
# 用法：下载 cloudflared-windows-amd64.exe 保存为 tools\cloudflared.exe，然后取消下面两行注释
# TUNNEL_PROVIDER=cloudflared
# TUNNEL_CLOUDFLARED_PROTOCOL=http2

# ===== 其他 =====
APP_TZ=Asia/Shanghai
DEMO_MODE=0
RETENTION_DAYS=30
